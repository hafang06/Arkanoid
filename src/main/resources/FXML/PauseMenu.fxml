<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Game.PauseController">
    <ImageView fx:id="background" fitHeight="600" fitWidth="800" preserveRatio="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <image>
            <Image url="@../Image/PauseMenu.png" />
        </image>
    </ImageView>
   <Button fx:id="btnResume" blendMode="SCREEN" layoutX="101.0" layoutY="374.0" mnemonicParsing="false" onAction="#onResumeClicked" prefHeight="44.0" prefWidth="163.0" style="-fx-background-color: #b26cff; -fx-text-fill: white; -fx-border-color: #e2b8ff; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10; -fx-font-size: 16; -fx-font-weight: bold; -fx-font-family: System; -fx-effect: dropshadow(three-pass-box, rgba(255,255,255,0.4), 5, 0, 0, 0);" text="RESUME" />
   <Button fx:id="btnSaveAndQuit" blendMode="SCREEN" layoutX="282.0" layoutY="374.0" mnemonicParsing="false" onAction="#onSaveAndQuitClicked" prefHeight="44.0" prefWidth="232.0" style="-fx-background-color: #b26cff; -fx-text-fill: white; -fx-border-color: #e2b8ff; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10; -fx-font-size: 16px; -fx-font-weight: bold; -fx-font-family: System; -fx-effect: dropshadow(three-pass-box, rgba(255,255,255,0.4), 5, 0, 0, 0);;" text="SAVE AND QUIT" />
   <Button fx:id="btnQuit" blendMode="SCREEN" layoutX="531.0" layoutY="374.0" mnemonicParsing="false" onAction="#onQuitClicked" prefHeight="44.0" prefWidth="147.0" style="-fx-background-color: #b26cff; -fx-text-fill: white; -fx-border-color: #e2b8ff; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10; -fx-font-size: 16px; -fx-font-weight: bold; -fx-font-family: System; -fx-effect: dropshadow(three-pass-box, rgba(255,255,255,0.4), 5, 0, 0, 0);" text="QUIT" />

</AnchorPane>
