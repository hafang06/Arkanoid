<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600" prefWidth="800" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Game.MenuController">
    <ImageView fx:id="background" fitHeight="600" fitWidth="800" preserveRatio="false" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <image>
            <Image url="@../Image/anhnen.jpg" />
        </image>
    </ImageView>
   <Button fx:id="onePlayerButton" layoutX="293.0" layoutY="406.0" mnemonicParsing="false" onAction="#onOnePlayerClick" prefHeight="20.0" prefWidth="180.0" style="-fx-background-color: linear-gradient(from 0.0% 0.0% to 100.0% 100.0%, #1b2f79 0.0%, #ffffff 100.0%);" text="PLAY" textFill="#1c3078">
      <font>
         <Font name="Berlin Sans FB Bold" size="18.0" />
      </font>
   </Button>
   <Button fx:id="twoPlayerButton" layoutX="444.0" layoutY="464.0" mnemonicParsing="false" onAction="#onTwoPlayerClick" prefHeight="20.0" prefWidth="180.0" style="-fx-background-color: linear-gradient(from 0.0% 0.0% to 100.0% 100.0%, #1b2f79 0.0%, #ffffff 100.0%);" text="2 PLAYER" textFill="#1c3078">
      <font>
         <Font name="Berlin Sans FB Bold" size="17.0" />
      </font>
   </Button>
    <Button fx:id="ResumeButton" layoutX="144.0" layoutY="464.0" mnemonicParsing="false" prefHeight="20.0" prefWidth="180.0" style="-fx-background-color: linear-gradient(from 0.0% 0.0% to 100.0% 100.0%, #1b2f79 0.0%, #ffffff 100.0%);" text="RESUME" textFill="#1c3078">
        <font>
            <Font name="Berlin Sans FB Bold" size="17.0" />
        </font>
    </Button>
    <Button fx:id="GuideButton" layoutX="444.0" layoutY="519.0" mnemonicParsing="false" prefHeight="20.0" prefWidth="180.0" style="-fx-background-color: linear-gradient(from 0.0% 0.0% to 100.0% 100.0%, #1b2f79 0.0%, #ffffff 100.0%);" text="GUIDE" textFill="#1c3078">
        <font>
            <Font name="Berlin Sans FB Bold" size="17.0" />
        </font>
    </Button>
    <Button fx:id="exitButton" layoutX="144.0" layoutY="519.0" mnemonicParsing="false"  onAction= "#onExitClick" prefHeight="20.0" prefWidth="180.0" style="-fx-background-color: linear-gradient(from 0.0% 0.0% to 100.0% 100.0%, #1b2f79 0.0%, #ffffff 100.0%);" text="QUIT" textFill="#1c3078">
        <font>
            <Font name="Berlin Sans FB Bold" size="17.0" />
        </font>
    </Button>
</AnchorPane>
